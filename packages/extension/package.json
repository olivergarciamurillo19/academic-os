{
  "name": "@academic-os/extension",
  "version": "1.0.0",
  "private": true,
  "description": "UAL Bridge — Academic OS Chrome MV3 extension that mirrors Aula Virtual UAL into the app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "build:extension": "pnpm build",
    "dev": "node scripts/bundle.mjs --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'extension lint: noop (no eslint config)'"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
