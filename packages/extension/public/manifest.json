{
  "manifest_version": 3,
  "name": "UAL Bridge — Academic OS",
  "description": "Sincroniza anuncios, tareas y materiales de Aula Virtual UAL con tu Academic OS.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "UAL Bridge"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "identity", "alarms"],
  "host_permissions": [
    "https://aulavirtual.ual.es/*",
    "https://academic-os-mu.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://aulavirtual.ual.es/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["https://academic-os-mu.vercel.app/*"]
    }
  ]
}
