# Academic OS — environment variables example
# Copy to .env.local (Next.js) and fill in real values. Never commit the filled file.

# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=

# --- Jobs / Queues --------------------------------------------------------
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Observability --------------------------------------------------------
# Sentry — set DSN to enable client + server. AUTH_TOKEN only needed in CI
# for source map uploads; local dev works without it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=academic-os-web

# PostHog — host defaults to eu.i.posthog.com if unset.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
